<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetTrackSlot">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_chip</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <style name="WidgetTrackDot">
        <item name="android:layout_width">8dp</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:src">@drawable/widget_dot</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="WidgetTrackName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_on_bg</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
