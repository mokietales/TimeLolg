<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!--
      Status header in two lines so it fits a narrow 2x2: the theme name on top;
      the clock (or a hint) with pause / stop (or a blank quick start) below.
    -->
    <LinearLayout
        android:id="@+id/hdr"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/hdr_dot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot"
                android:visibility="gone" />

            <TextView
                android:id="@+id/hdr_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/widget_on_bg"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <Chronometer
                    android:id="@+id/hdr_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_bg_variant"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hdr_sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="点主题开始"
                    android:textColor="@color/widget_on_bg_variant"
                    android:textSize="12sp" />
            </FrameLayout>

            <ImageView
                android:id="@+id/hdr_pause"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_round_secondary"
                android:contentDescription="暂停或继续"
                android:padding="7dp"
                android:src="@drawable/ic_widget_pause"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/hdr_stop"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_round_primary"
                android:contentDescription="结束"
                android:padding="8dp"
                android:src="@drawable/ic_widget_stop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/hdr_quick"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_round_primary"
                android:contentDescription="快速开始"
                android:padding="7dp"
                android:src="@drawable/ic_widget_play" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:text="点主题，归入当前计时"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="在 app 里新建主题后，可以在这里一键开始"
        android:textColor="@color/widget_on_bg_variant"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Fixed-height rows, top aligned; how many are shown depends on the widget's height. -->
    <LinearLayout
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout android:id="@+id/row0" style="@style/WidgetTrackRow">
            <LinearLayout android:id="@+id/slot0" style="@style/WidgetTrackSlot" android:layout_marginEnd="3dp">
                <ImageView android:id="@+id/slot0_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot0_name" style="@style/WidgetTrackName" />
            </LinearLayout>
            <LinearLayout android:id="@+id/slot1" style="@style/WidgetTrackSlot" android:layout_marginStart="3dp">
                <ImageView android:id="@+id/slot1_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot1_name" style="@style/WidgetTrackName" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/row1" style="@style/WidgetTrackRow">
            <LinearLayout android:id="@+id/slot2" style="@style/WidgetTrackSlot" android:layout_marginEnd="3dp">
                <ImageView android:id="@+id/slot2_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot2_name" style="@style/WidgetTrackName" />
            </LinearLayout>
            <LinearLayout android:id="@+id/slot3" style="@style/WidgetTrackSlot" android:layout_marginStart="3dp">
                <ImageView android:id="@+id/slot3_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot3_name" style="@style/WidgetTrackName" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/row2" style="@style/WidgetTrackRow">
            <LinearLayout android:id="@+id/slot4" style="@style/WidgetTrackSlot" android:layout_marginEnd="3dp">
                <ImageView android:id="@+id/slot4_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot4_name" style="@style/WidgetTrackName" />
            </LinearLayout>
            <LinearLayout android:id="@+id/slot5" style="@style/WidgetTrackSlot" android:layout_marginStart="3dp">
                <ImageView android:id="@+id/slot5_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot5_name" style="@style/WidgetTrackName" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/row3" style="@style/WidgetTrackRow">
            <LinearLayout android:id="@+id/slot6" style="@style/WidgetTrackSlot" android:layout_marginEnd="3dp">
                <ImageView android:id="@+id/slot6_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot6_name" style="@style/WidgetTrackName" />
            </LinearLayout>
            <LinearLayout android:id="@+id/slot7" style="@style/WidgetTrackSlot" android:layout_marginStart="3dp">
                <ImageView android:id="@+id/slot7_dot" style="@style/WidgetTrackDot" />
                <TextView android:id="@+id/slot7_name" style="@style/WidgetTrackName" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
